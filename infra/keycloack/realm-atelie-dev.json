{
  "realm": "atelie",
  "enabled": true,
  "displayName": "Atelie Digital",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "duplicateEmailsAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@atelie.dev",
    "fromDisplayName": "Atelie Digital",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "defaultRole": {
    "name": "default-roles-atelie",
    "description": "Papel padrao do realm"
  },
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "CLIENT",
        "description": "Cliente (papel padrao)"
      },
      {
        "name": "ARTISAN",
        "description": "Artesao",
        "composite": true,
        "composites": {
          "realm": [
            "CLIENT"
          ]
        }
      },
      {
        "name": "ADMIN",
        "description": "Administrador"
      },
      {
        "name": "default-roles-atelie",
        "description": "Papel padrao do realm",
        "composite": true,
        "composites": {
          "realm": [
            "CLIENT",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "atelie-web",
      "name": "Atelie Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "atelie-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atelie-core",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "atelie-core",
      "name": "Atelie Core (API / audiencia)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "atelie-core-roles",
      "name": "Atelie Core - atribuicao de papeis",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ROLES_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": []
    }
  ],
  "users": [
    {
      "username": "cliente@atelie.dev",
      "email": "cliente@atelie.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Cliente",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CLIENT"
      ]
    },
    {
      "username": "artesao@atelie.dev",
      "email": "artesao@atelie.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Artesao",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ARTISAN",
        "CLIENT"
      ]
    },
    {
      "username": "admin@atelie.dev",
      "email": "admin@atelie.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "CLIENT"
      ]
    },
    {
      "username": "service-account-atelie-core-roles",
      "enabled": true,
      "serviceAccountClientId": "atelie-core-roles",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ]
}