DATABASE_URL=jdbc:postgresql://localhost:5432/mydatabase
DATABASE_NAME=mydatabase
DATABASE_USERNAME=myuser
DATABASE_PASSWORD=secret
DATABASE_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=example


KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=atelie
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ROLES_CLIENT_ID=atelie-core-roles
KEYCLOAK_ROLES_CLIENT_SECRET=dev-client-secret-example

KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/atelie
KEYCLOAK_AUDIENCE=atelie-core

GOOGLE_CLIENT_ID=google-client-id-placeholder
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder

# Origem do front-end (CORS da API e redirects do client atelie-web no realm de prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173
ATELIE_WEB_ORIGIN=http://localhost:5173

# SMTP do Keycloak - dev usa o Mailpit do compose (UI em http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMTP do Keycloak - prod (realm-atelie-prod.json)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=smtp-user-example
SMTP_PASSWORD=smtp-password-example

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=atelie

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/