{
  "info": {
    "name": "Ateliê Digital — Carrinho",
    "description": "Endpoints de docs/carrinho.md contra os serviços locais (app :8080, Keycloak :8180, catalog_stub.py :8008). Rode as pastas em ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticação (Keycloak local)",
      "item": [
        {
          "name": "Login CLIENT (cliente@atelie.dev)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "username",
                  "value": "cliente@atelie.dev"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_client', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
